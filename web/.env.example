# このファイルをコピーして .env.local を作り、値を入れる（.env.local はコミットしない）
#   cp .env.example .env.local

# Claude API のキー（https://console.anthropic.com/ で発行）
ANTHROPIC_API_KEY=

# GitHub の Personal Access Token（コミットと差分の読み取りに使う。public リポジトリだけなら Contents: Read-only で十分）
GITHUB_TOKEN=

# Claude Code のフック（F-13）の受け取り箱の合言葉。ランダムな文字列を入れる（例：openssl rand -hex 32 の出力）
# フックのスクリプト（../hook/research-check.mjs）も、このファイルから読む。空のときは受け取り箱を使えない
RESEARCH_CHECK_TOKEN=
